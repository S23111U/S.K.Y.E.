{
    "model": "mlx-community/Phi-3-mini-4k-instruct-4bit",
    "train": true,
    "data": "data_prepared_mlx",
    "fine_tune_type": "lora",
    "batch_size": 2,
    "iters": 1500,
    "learning_rate": 1e-5,
    "num_layers": 16,
    "max_seq_length": 2048,
    "mask_prompt": true,
    "steps_per_report": 10,
    "steps_per_eval": 100,
    "save_every": 100,
    "adapter_path": "adapters_SKYE_V2",
    "optimizer": "adam",
    "grad_accumulation_steps": 1,
    "grad_checkpoint": false,
    "seed": 0,
    "val_batches": 25,
    "lora_parameters": {
        "rank": 8,
        "dropout": 0.0,
        "scale": 20.0
    }
}

