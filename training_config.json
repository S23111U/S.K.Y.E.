{
    "model": "mlx-community/Meta-Llama-3-8B-Instruct-4bit",
    "train": true,
    "data": "prepared_data_mlx",
    "fine_tune_type": "lora",
    "batch_size": 1,
    "iters": 2000,
    "learning_rate": 1e-5,
    "num_layers": 16,
    "max_seq_length": 2048,
    "mask_prompt": true,
    "steps_per_report": 10,
    "steps_per_eval": 100,
    "save_every": 200,
    "adapter_path": "SKYE",
    "optimizer": "adam",
    "grad_accumulation_steps": 4,
    "grad_checkpoint": true,
    "seed": 42,
    "val_batches": 25,
    "lora_parameters": {
        "rank": 16,
        "dropout": 0.05,
        "scale": 10.0
    }
}
